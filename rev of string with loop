#include<stdio.h>
#include<string.h>
int main()
{
    char s[20],rev[20];
    int len=0,i=0,j;
    printf("enter a string");
    scanf("%[^\n]s",s);
    while(s[i]!='\0')
    {
     len++;
     i++;
    }
    printf("length=%d\n",len);
    j=len-1;
    i=0;
    while(j>=0)
    {
        rev[i]=s[j];
        j--;
        i++;
    }
    rev[i]='\0';
    printf("reverse=%s",rev);
    return 0;
}
